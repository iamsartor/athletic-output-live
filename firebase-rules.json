{
  "rules": {
    "trainerPin": {
      ".read": false,
      ".write": false
    },
    "trainers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && newData.val() === root.child('trainerPin').val() + ''"
      }
    },
    "keys": {
      "$event": {
        ".read": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        ".write": "($event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || $event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/)) && (auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{6,12}$/)"
      }
    },
    "members": {
      "$event": {
        ".write": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && $event === root.child('current').val()",
          ".validate": "newData.hasChildren(['k', 't'])",
          "k": {
            ".validate": "newData.isString() && root.child('keys').child($event).exists() && newData.val() === root.child('keys').child($event).val()"
          },
          "t": {
            ".validate": "newData.isString() && (newData.val() === '' || root.child('events').child($event).child('teams').child(newData.val()).exists())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "online": {
      ".read": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
      "$id": {
        ".write": "auth != null && $id.matches(/^[a-z0-9]{10}-[a-z0-9]{4}$/)",
        ".validate": "newData.hasChildren(['e', 'k', 't'])",
        "e": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "k": {
          ".validate": "newData.isString() && newData.val().matches(/^(team|pick|screen|trainer)$/)"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "seen": {
      ".read": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
      "$event": {
        ".write": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        "$dev": {
          ".write": "auth != null && ($event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || $event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/)) && $dev.matches(/^[a-z0-9]{10}$/) && newData.exists() && root.child('events').child($event).exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "current": {
      ".read": true,
      ".write": "(auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
      ".validate": "newData.isString() && (newData.val().matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || newData.val().matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/))"
    },
    "workouts": {
      ".read": true,
      "$workout": {
        ".write": "$workout.matches(/^[a-z0-9-]{1,20}$/) && (auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        ".validate": "newData.isString() && newData.val().length <= 6000 && !newData.val().contains('<')"
      }
    },
    "events": {
      ".read": true,
      "$event": {
        ".read": "($event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || $event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/))",
        ".write": "($event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || $event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/)) && (auth != null && root.child('trainerPin').exists() && (root.child('trainerPin').val() + '').length >= 4 && root.child('trainers').child(auth.uid).val() === root.child('trainerPin').val() + '')",
        "created": {
          ".validate": "newData.isNumber()"
        },
        "workout": {
          ".validate": "newData.isString() && newData.val().length <= 6000 && !newData.val().contains('<')"
        },
        "clock": {
          "$round": {
            ".validate": "$round.matches(/^r[0-9]$/) && newData.isNumber()"
          }
        },
        "teams": {
          "$team": {
            ".validate": "$team.matches(/^[a-z0-9]{1,10}$/) && newData.hasChildren(['name', 'order'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30 && !newData.val().contains('<')"
            },
            "order": {
              ".validate": "newData.isNumber()"
            },
            "start": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
            },
            "size": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "counts": {
          "$team": {
            ".validate": "$team.matches(/^[a-z0-9]{1,10}$/)",
            "$round": {
              ".validate": "$round.matches(/^r[0-9]$/)",
              "$field": {
                ".write": "($event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]$/) || $event.matches(/^202[5-9]-[01][0-9]-[0-3][0-9]-[2-9]$/)) && root.child('events').child($event).child('teams').child($team).exists() && auth != null && $event === root.child('current').val() && root.child('events').child($event).child('locked').val() !== true && root.child('keys').child($event).exists() && root.child('members').child($event).child(auth.uid).child('k').val() === root.child('keys').child($event).val() && root.child('members').child($event).child(auth.uid).child('t').val() === $team",
                ".validate": "$field.matches(/^[a-z0-9]{1,8}(_[a-z0-9]{1,3})?$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              }
            }
          }
        },
        "locked": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}